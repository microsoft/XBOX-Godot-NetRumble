<?xml version="1.0" encoding="utf-8"?>
<Game configVersion="1">
  <!--
    Game configuration for Xbox Series X|S. The "Xbox Series X|S" export preset
    names this file in application/game_config, and the exporter stages it as
    MicrosoftGame.config at the root of the console layout or package.

    The config at the project root is the PC config. Identity, StoreId,
    TitleId, MSAAppId, ShellVisuals and AdvancedUserModel must match the root
    config; tools/check-game-config.ps1 fails when they drift. The root config
    explains each of those values.

    There is no DesktopRegistration element: it is PC-only.

    Logo paths are bare file names. The preset's packaging/metadata_folder names
    the shared storelogos folder, and the exporter places these logos beside
    this file at the package root.

    The executable name must match the preset's export_path, NetRumbleConsole.exe.
    tools/deploy-console.ps1 stops when they differ.

    Keep this file free of trailing whitespace after the closing Game tag, and
    never spell an Executable start-tag with a Name attribute inside a comment.
    The root config explains both rules.
  -->

  <Identity
    Name="41336MicrosoftATG.GodotNetRumble"
    Publisher="CN=A4954634-DF4B-47C7-AB70-D3215D246AF1"
    Version="1.0.1.0" />

  <ExecutableList>
    <Executable Name="NetRumbleConsole.exe" TargetDeviceFamily="Scarlett" Id="GameConsole" />
  </ExecutableList>
  <StoreId>9P7KW6GFS17X</StoreId>

  <TitleId>7C84AA93</TitleId>
  <MSAAppId>84983aff-dc3c-4cbb-8e88-aa51c4b0f5d9</MSAAppId>

  <ShellVisuals
    DefaultDisplayName="GodotNetRumble"
    PublisherDisplayName="Xbox ATG"
    StoreLogo="StoreLogo.png"
    Square150x150Logo="Logo.png"
    Square44x44Logo="SmallLogo.png"
    Square480x480Logo="LargeLogo.png"
    Description="A Godot multiplayer sample demonstrating Microsoft GDK and PlayFab integration."
    ForegroundText="dark"
    BackgroundColor="#000000"
    SplashScreenImage="SplashScreen.png" />

  <AdvancedUserModel>false</AdvancedUserModel>

</Game>