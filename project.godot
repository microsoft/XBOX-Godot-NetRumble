; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="NetRumble"
config/description="A Godot 4 demonstration of Microsoft GDK and PlayFab: Xbox sign-in, Lobby discovery, Party networking, voice and in-match typed text, privileges and privacy, activity and invites, achievements, and console Game Save."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://assets/textures/UI/Logo/Logo_NetRumbleIcon.png"

[autoload]

XboxBootstrap="*res://addons/godot_gdk/runtime/gdk_bootstrap.gd"
Assets="*res://scripts/autoload/assets.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
PlayerProfile="*res://scripts/autoload/player_profile.gd"
Services="*res://scripts/autoload/services.gd"
NetManager="*res://scripts/autoload/net_manager.gd"
ScreenManager="*res://scripts/autoload/screen_manager.gd"
InviteRouter="*res://scripts/autoload/invite_router.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_gdk/plugin.cfg", "res://addons/godot_playfab/plugin.cfg", "res://addons/godot_gdk_editortools/plugin.cfg")

[gdk]

runtime/initialize_on_startup=true
runtime/singleton_name="XBOX"

[gui]

theme/custom="res://assets/ui/netrumble.tres"

